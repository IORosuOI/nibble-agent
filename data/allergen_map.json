    "milk": "cow's milk and dairy products",
    "egg": "eggs and egg products",
    "fish": "finned fish and fish-based sauces",
    "shellfish": "union of crustaceans and molluscs (kept so older filters keep working)",
    "tree_nut": "almond, walnut, pecan, cashew, pistachio, hazelnut, macadamia, pine nut, chestnut... (coconut is not counted)",
    "peanut": "peanuts (a legume, listed separately from tree nuts)",
    "soy": "soybeans and soy products",
    "sesame": "sesame seeds, tahini and sesame oil",
    "wheat": "wheat and wheat flour products",
    "gluten": "wheat, barley, rye and their products (wheat always implies gluten)",
    "crustaceans": "shrimp, prawn, crab, lobster, crayfish, langoustine, krill",
    "molluscs": "clams, mussels, oysters, scallops, squid, octopus, snails, abalone",
    "celery": "celery, celeriac, celery seed and celery salt",
    "mustard": "mustard seed, mustard powder, prepared mustard, dijon",
    "lupin": "lupin / lupine flour and seeds",
    "sulphites": "sulphur dioxide and sulphites; wine, sherry, vermouth and dried apricots are counted because they usually contain them"
